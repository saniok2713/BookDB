<Window x:Class="BookDB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookDB"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <StackPanel Orientation="Horizontal">
                <Label Content="Nome:"></Label>
                <TextBox Width="152" Height="20"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Autore:"></Label>
                <TextBox Width="152" Height="20"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Anno:"></Label>
                <TextBox Width="152" Height="20"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Pagine:"></Label>
                <TextBox Width="152" Height="20"></TextBox>
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <ListBox>
                <ListBoxItem Content="Elemento 1"/>
                <ListBoxItem Content="Elemento 2"/>
                <ListBoxItem Content="Elemento 3"/>
            </ListBox>
        </StackPanel>


    </Grid>

</Window>
