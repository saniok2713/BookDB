<Window x:Class="BookDB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookDB"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <Grid Margin="0.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Nome:" Grid.Column="0"/>
                <TextBox Grid.Column="1" Width="150" Height="20"/>
            </Grid>
            <Grid Margin="0.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Autore:" Grid.Column="0"/>
                <TextBox Grid.Column="1" Width="150" Height="20"/>
            </Grid>
            <Grid Margin="0.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Anno:" Grid.Column="0"/>
                <TextBox Grid.Column="1" Width="150" Height="20"/>
            </Grid>
            <Grid Margin="0.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Pagine:" Grid.Column="0"/>
                <TextBox Grid.Column="1" Width="150" Height="20"/>
            </Grid>
            <Grid Margin="0.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Lingua:" Grid.Column="0"/>
                <TextBox Grid.Column="1" Width="150" Height="20"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <ListBox>
                <ListBoxItem Content="Il gioco interiore nel tennis 192 pagine"/>
                <ListBoxItem Content="Elemento 2"/>
                <ListBoxItem Content="Elemento 3"/>
            </ListBox>
        </StackPanel>


    </Grid>

</Window>
